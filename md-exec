#!/usr/bin/env python3
"""md-exec: run Markdown files as programs.

Registered as a binfmt_misc interpreter for the .md extension, so the kernel
runs `md-exec /path/to/file.md [args...]` whenever an executable .md file is
exec'd. The Markdown is handed to the `claude` CLI, which works out what
program the document describes and writes it in Python. The result is cached
by content hash, so re-running an unchanged file runs the same script.

Environment:
  MD_EXEC_MODEL       model passed to `claude --model` (part of the cache key)
  MD_EXEC_REGENERATE  if set, ignore any cached script and generate a new one
  MD_EXEC_SHOW        if set, print the generated script instead of running it
  MD_EXEC_CACHE_DIR   cache location (default: $XDG_CACHE_HOME/md-exec)
"""

import fcntl
import hashlib
import os
import re
import runpy
import subprocess
import sys
import tempfile

# Bump this whenever SYSTEM_PROMPT changes meaning, so old cache entries stop
# matching. (The prompt text is also hashed, but this makes intent explicit.)
CACHE_VERSION = "1"

SYSTEM_PROMPT = """\
You are a compiler whose source language is Markdown and whose target \
language is Python 3.

The user message is the complete contents of a Markdown file that someone \
has marked executable and run from a shell. Work out what program the \
document describes, then write that program.

- If the document is a spec, README, man page or description of a tool, \
implement that tool.
- If it is something else (a recipe, a story, notes, a poem), write the \
program that most delightfully "performs" it, e.g. an interactive \
step-by-step guide, an animation, or a quiz.
- Command-line arguments are in sys.argv[1:]; sys.argv[0] is the path of the \
Markdown file. Read stdin and write stdout/stderr as a normal Unix tool would.
- Use only the Python standard library.
- Exit with a non-zero status on errors.

Respond with only the Python source code: no Markdown fences, no prose \
before or after it."""


def die(msg):
    print(f"md-exec: {msg}", file=sys.stderr)
    sys.exit(127)


def cache_dir():
    if d := os.environ.get("MD_EXEC_CACHE_DIR"):
        return d
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "md-exec")


def cache_key(source, model):
    h = hashlib.sha256()
    for part in (CACHE_VERSION, SYSTEM_PROMPT, model or ""):
        h.update(part.encode())
        h.update(b"\0")
    h.update(source)
    return h.hexdigest()


def strip_fences(text):
    # The prompt asks for bare code, but models sometimes fence it anyway.
    m = re.search(r"```(?:python3?|py)?[ \t]*\n(.*?)\n```", text, re.DOTALL)
    return m.group(1) if m else text


def generate(source, md_path, model, workdir):
    cmd = [
        "claude",
        "--print",
        "--output-format", "text",
        "--system-prompt", SYSTEM_PROMPT,
        "--tools", "",
        "--no-session-persistence",
    ]
    if model:
        cmd += ["--model", model]

    print(f"md-exec: compiling {md_path} with claude...", file=sys.stderr)
    try:
        # Run from the cache dir so no project CLAUDE.md leaks into the prompt.
        proc = subprocess.run(
            cmd,
            input=source,
            capture_output=True,
            cwd=workdir,
        )
    except FileNotFoundError:
        die("`claude` not found on PATH")
    if proc.returncode != 0:
        sys.stderr.buffer.write(proc.stderr)
        die(f"claude exited with status {proc.returncode}")

    code = strip_fences(proc.stdout.decode()).strip() + "\n"
    try:
        compile(code, md_path, "exec")
    except SyntaxError as e:
        die(f"claude produced invalid Python ({e}); not caching it")
    return code


def load_or_generate(md_path):
    try:
        with open(md_path, "rb") as f:
            source = f.read()
    except OSError as e:
        die(f"cannot read {md_path}: {e.strerror}")

    model = os.environ.get("MD_EXEC_MODEL")
    d = cache_dir()
    os.makedirs(d, exist_ok=True)
    key = cache_key(source, model)
    script = os.path.join(d, f"{key}.py")

    # Hold a per-key lock so concurrent first runs only call claude once.
    with open(os.path.join(d, f"{key}.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if os.environ.get("MD_EXEC_REGENERATE") or not os.path.exists(script):
            code = generate(source, md_path, model, d)
            fd, tmp = tempfile.mkstemp(dir=d, suffix=".tmp")
            with os.fdopen(fd, "w") as f:
                f.write(f"# Generated by md-exec from {os.path.abspath(md_path)}\n")
                f.write(code)
            os.replace(tmp, script)
    return script


def main():
    if len(sys.argv) < 2:
        die("usage: md-exec FILE.md [ARGS...]")
    md_path = sys.argv[1]
    script = load_or_generate(md_path)

    if os.environ.get("MD_EXEC_SHOW"):
        with open(script) as f:
            sys.stdout.write(f.read())
        return

    sys.argv = [md_path, *sys.argv[2:]]
    sys.path[0] = os.path.dirname(os.path.abspath(md_path))
    runpy.run_path(script, run_name="__main__")


if __name__ == "__main__":
    main()
